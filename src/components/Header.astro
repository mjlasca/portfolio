---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class:list={['site-header', { 'site-header--dark': dark }] }>
  <a class="brand" href={base} aria-label="Inicio de Mario Lasluisa">
    <span class="brand-mark">ML</span>
    <span class="brand-name">Mario<br />Lasluisa</span>
  </a>
  <a class="availability" href="mailto:mjlasca@gmail.com">
    <span class="availability-dot"></span>
    Disponible para oportunidades backend
  </a>
  <nav class="main-nav" aria-label="Navegación principal">
    <a href={`${base}#about`}>Sobre mí</a>
    <a href={`${base}#work`}>Trabajo</a>
    <a href={`${base}#experience`}>Experiencia</a>
    <a href={`${base}#contact`}>Contacto</a>
    <a href={`${base}cv-mario-lasluisa.pdf`} download>CV ↘</a>
  </nav>
</header>
