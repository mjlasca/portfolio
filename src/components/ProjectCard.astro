---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<a
  class:list={['project-card', { 'project-card--featured': featured }]}
  href={`/work/${project.slug}`}
  style={`--card-accent: ${project.accent}`}
  data-reveal
>
  <div class="project-card__media">
    <img src={project.cover} alt={`Vista previa del proyecto ${project.title}`} loading="lazy" />
    <span class="project-card__arrow" aria-hidden="true">↗</span>
  </div>
  <div class="project-card__meta">
    <span class="project-number">{project.number}</span>
    <div>
      <p class="project-card__eyebrow">{project.eyebrow}</p>
      <h3>{project.title}</h3>
      <p class="project-card__summary">{project.summary}</p>
    </div>
    <span class="project-card__type">Caso de estudio</span>
  </div>
</a>
