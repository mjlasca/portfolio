---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<Layout>
  <main>
    <section class="hero-wrap">
      <Header dark />
      <Hero />
    </section>

    <section class="intro-section content-section" id="about" data-reveal>
      <div class="section-kicker"><span>01</span><span>Sobre Mario</span></div>
      <div class="intro-section__copy">
        <p class="display-copy">Construyo sistemas backend que hacen que las integraciones complejas sean <em>claras, confiables y mantenibles.</em></p>
        <div class="intro-section__details">
          <p>Desarrollador de software backend especializado en PHP, Drupal, Laravel y APIs REST. Trabajo con principios SOLID, inyección de dependencias, CI/CD e integración entre sistemas empresariales.</p>
          <a class="text-link" href="mailto:mjlasca@gmail.com">Hablemos <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="work-section content-section" id="work">
      <div class="section-heading" data-reveal>
        <div class="section-kicker"><span>02</span><span>Experiencia seleccionada</span></div>
        <p>Trabajo representativo<br />de mi experiencia profesional.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    </section>

    <section class="capabilities-section content-section" data-reveal>
      <div class="section-kicker"><span>03</span><span>Especialidades</span></div>
      <div class="capabilities-list">
        <div><span>01</span><h2>Arquitectura<br /><em>backend</em></h2></div>
        <div><span>02</span><h2>Integración<br /><em>de sistemas</em></h2></div>
        <div><span>03</span><h2>Calidad y<br /><em>entrega</em></h2></div>
      </div>
      <div class="stack-grid">
        <div><span>Backend</span><p>PHP · Drupal 9/10/11 · Laravel · C# · .NET Framework</p></div>
        <div><span>Arquitectura</span><p>SOLID · Inyección de dependencias · APIs REST</p></div>
        <div><span>Frontend</span><p>JavaScript · React · Vue · Inertia.js</p></div>
        <div><span>Datos</span><p>MySQL · MariaDB · SQLite · SQL Server</p></div>
        <div><span>Infraestructura</span><p>Acquia · Docker · Linux · Composer · CI/CD</p></div>
        <div><span>Calidad y búsqueda</span><p>Apache Solr · PHPUnit · Pest · Playwright</p></div>
        <div><span>Nube</span><p>AWS · conocimientos básicos</p></div>
      </div>
    </section>

    <section class="experience-section content-section" id="experience" data-reveal>
      <div class="section-kicker"><span>04</span><span>Experiencia y formación</span></div>
      <div class="experience-list">
        <article class="experience-item">
          <div class="experience-item__date">Oct 2022<br />— Jul 2026</div>
          <div>
            <h2>Esinergia SAS</h2>
            <p class="experience-item__role">Desarrollador de software backend · Remoto</p>
            <p>Desarrollo backend empresarial con PHP y Drupal 9, 10 y 11. Módulos personalizados, servicios desacoplados, integraciones con terceros, migraciones de Drupal, Apache Solr, calidad de código y flujos CI/CD en Acquia.</p>
          </div>
        </article>
        <article class="experience-item">
          <div class="experience-item__date">Oct 2017<br />— Mar 2022</div>
          <div>
            <h2>EspecialistasenExcel.com</h2>
            <p class="experience-item__role">Desarrollador de software freelance · Remoto</p>
            <p>APIs con Laravel, un ERP propio con React e Inertia.js, aplicaciones de escritorio con C# y .NET Framework, automatización de flujos de trabajo e integración con impresoras, cámaras y lectores de huella.</p>
          </div>
        </article>
      </div>
      <div class="credentials">
        <div><span>Certificación</span><a href="https://certification.acquia.com/person/certified/mario-lasluisa" target="_blank" rel="noreferrer">Acquia Certified Drupal Site Builder ↗</a><small>27 de septiembre de 2024</small></div>
        <div><span>Formación</span><strong>Tecnólogo en Sistemas</strong><small>Corporación Universitaria Minuto de Dios · Cali · 2014—17</small></div>
      </div>
    </section>

    <section class="contact-section content-section" id="contact" data-reveal>
      <div class="section-kicker"><span>05</span><span>¿Tienes un reto backend?</span></div>
      <h2>Construyamos<br /><em>algo sólido.</em></h2>
      <a class="contact-email" href="mailto:mjlasca@gmail.com">mjlasca@gmail.com <span>↗</span></a>
      <div class="contact-footer">
        <span>© 2026 Mario Lasluisa · Cali, Colombia</span>
        <div><a href="tel:+573016735425">+57 301 6734525</a><a href="/cv-mario-lasluisa.pdf" download>Descargar CV</a></div>
      </div>
    </section>
  </main>
  <div class="progress-track" aria-hidden="true"><span data-progress></span></div>
</Layout>
